{
  "manifest_version": 3,
  "name": "MoviPlayer",
  "version": "0.4.1",
  "description": "Play MKV, HEVC, AV1, WebM & 4K HDR videos your browser can't open natively \u2014 no upload, no conversion, right in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "movi-player@moviplayer.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "clipboardRead",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "marker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "siteplayer.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "player.js",
        "upgrade.js",
        "dist/*"
      ],
      "matches": [
        "<all_urls>",
        "file:///*"
      ]
    }
  ],
  "action": {
    "default_title": "MoviPlayer",
    "default_popup": "popup.html"
  }
}
