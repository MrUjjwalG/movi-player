                "value": "dash.js"
              }
            },
            {
              "name": "hlsjs",
              "description": {
                "kind": "markdown",
                "value": "hls.js"
              }
            },
            {
              "name": "native",
              "description": {
                "kind": "markdown",
                "value": "the browser's own <video>, under Movi's UI"
              }
            }
